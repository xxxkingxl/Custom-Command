{
  "manifest_version": 3,
  "name": "Roblox Favorite Bundles",
  "version": "1.3",
  "description": "Adds a 'Shoe Pairs' entry to Roblox's Favorites page, listing favorited shoe bundles.",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "browser_specific_settings": {
    "gecko": { "id": "roblox-fav-bundles@local", "strict_min_version": "115.0" }
  },
  "host_permissions": [
    "https://www.roblox.com/*",
    "https://catalog.roblox.com/*",
    "https://users.roblox.com/*",
    "https://thumbnails.roblox.com/*"
  ],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    { "matches": ["https://www.roblox.com/*"], "js": ["content.js"] }
  ]
}
